<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/css/sb-admin-2.min.css" rel="stylesheet" />
    <title>Document</title>
  </head>
  <style>
    * {
      box-sizing: border-box;
      margin: 0px;
      padding: 0px;
    }
    .login-bg {
      background: radial-gradient(
        circle,
        rgba(2, 0, 36, 1) 0%,
        rgba(38, 37, 69, 1) 25%,
        rgba(52, 52, 82, 1) 35%,
        rgba(122, 84, 40, 1) 50%,
        rgba(0, 212, 255, 1) 100%
      );
      height: 100vh;
      width: 100vw;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-box {
      background-color: white;
      width: 400px;
      min-height: 250px;
      display: flex;
      justify-content: center;
      align-items: center;
      border-radius: 10px;
      padding: 10px;
    }
    @media (max-width: 400px) {
      .login-box {
        width: 90%;
      }
    }
    .login-form {
      display: flex;
      flex-direction: column;
    }
    .con {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    form {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      /* justify-content: center; */
      /* padding: 10px; */
      width: 70%;
      /* border: solid red; */
    }
    form div {
      width: 100%;
    }
    input {
      width: 100%;
      margin-bottom: 10px;
      height: 40px;
    }
    label {
      margin-bottom: 5px;
    }
  </style>
  <body>
    <div class="login-bg">
      <div class="login-box">
        <form class="login-form" action="/forgot-password" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="con">
            <label for="email">email</label>
            <input id="email" name="email" required  placeholder="enter your email" />
          </div>
         
          <%if(locals.error){ %>
          <span style="color: red; margin-bottom: 10px">* user not found</span>
          <% }%>
          <%if(locals.forgotPassword){ %>
            <a style="color: blue; margin-bottom: 10px" href="/reset-password">forgot password?</a>
            <% }%>
          <button class="btn btn-primary">Reset</button>
        </form>
      </div>
    </div>
  </body>
</html>
