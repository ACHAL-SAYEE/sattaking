function createSpinItem(i) {

  let spinItem = document.createElement("div");
  spinItem.classList.add("number")
  if(i>=0 && i<=9){
    spinItem.textContent = `0${i}`;

  }
  else{
    spinItem.textContent = i;

  }
  if (i === 1) {
    // console.log("applied");
    // spinItem.style.zIndex = "1";
    spinItem.style.backgroundColor = "#ff9800";
    return spinItem;
  }
  if (i % 5 === 0) {
    spinItem.style.backgroundColor = "#3f51b5";
  } else if (i % 5 === 1) {
    spinItem.style.backgroundColor = "#ff9800";
  } else if (i % 5 === 2) {
    spinItem.style.backgroundColor = "#e91e63";
  } else if (i % 5 === 3) {
    spinItem.style.backgroundColor = "#4caf50";
  } else {
    spinItem.style.backgroundColor = "#009688";
  }
  spinItem.style.transform = `rotate(${rotateval * (i - 1)}deg)`;
  return spinItem;
}
for (let i = 1; i <= points; i++) {
  let spinItem = createSpinItem(i);
  container.appendChild(spinItem);
}
