  padding: 0;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 600px;
  overflow: hidden;
}
/* @media (min-width: 400px) {
    .wheel-container{
        height: 600px;
    }
} */
.wheel-container {
  
  background-color: #ccc;
  border-radius: 50%;
  border: 15px solid #dde;
  position: relative;
  /* overflow: hidden; */
  /* transform: rotate(0deg); */
  transition: transform 7s;
}
@media (max-width: 500px) {
    .wheel-container{
        height:  90vw;
        width:90vw;
    }
}

#spin {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  background-color: #e2e2e2;
  text-transform: uppercase;
  border: 8px solid #fff;
  font-weight: bold;
  font-size: 18px;
  color: #a2a2a2;
  width: 80px;
  height: 80px;
  font-family: sans-serif;
  border-radius: 50%;
  text-align: center;
  /* cursor: pointer; */
  outline: none;
  /* letter-spacing: 1px; */
  transition: font-size 2s ;
}

.spinPointer {
    position: absolute;
    width: 20px;
    height: calc(50% - 59px);
    background: #fff;
    clip-path: polygon(50% 0%, 15% 100%, 85% 100%);
    z-index: 15;
    /* top: calc(50% - 120px); */
    top: 14px;
    left: calc(50% - 10px);
}

@media (min-width: 500px) {
    .wheel-container{
       width: 500px;
       height: 500px;
    }
    /* .spinPointer {
        transform: translateX(15px);

    } */
}
