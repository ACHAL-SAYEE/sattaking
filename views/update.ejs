<%- include("partials/header"); -%>

                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">
                    <div class="col-xl-12 col-lg-12">
                        <div class="card shadow mb-4">
                            <!-- Card Header - Dropdown -->
                            <div
                                class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                <h6 class="m-0" style="color: #501bd7eb; font-weight: 700;">Update value</h6>
                            </div>
                            <!-- Card Body -->
                            <div class="card-body">
                                <form action="/add/value" method="post" id="updateForm">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                    <div class="form-group">
                                      <label for="GameName">Game Name<sup>*</sup></label>
                                      <select name="name" id="GameName" required class="form-control" aria-placeholder="">
                                        <% for(var i=0; i < parray.length; i++){ %>
                                            <option value="<%= parray[i].name %>"><%= parray[i].name %></option>
                                        <% } %>       

                                     </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="value">Value<sup>*</sup></label>
                                        <input type="text" required class="form-control" id="value" aria-describedby="emailHelp" placeholder="" name="value">
                                    </div>
                                    <!--Image upload-->
                                    <button type="submit" class="btn btn-primary" style="background:#bcaced; color: #501bd7eb; font-weight: 700;">Submit</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
         
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="<%= domain %>/vendor/jquery/jquery.min.js"></script>
    <script src="<%= domain %>/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="<%= domain %>/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="<%= domain %>/js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="<%= domain %>/vendor/chart.js/Chart.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="<%= domain %>/js/demo/chart-area-demo.js"></script>
    <script src="<%= domain %>/js/demo/chart-pie-demo.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <script>
    // const socket = io("https://sattakingspinner.in",{transports: ['websocket']});
        const socket = io();

    console.log("socket",socket)
        // Function to handle form submission
        function handleSubmit(event) {
            // event.preventDefault(); // Prevent default form submission
    
            // Get form data
            const formData = new FormData(event.target);
    
            // Convert form data to JSON object
            const jsonData = {};
            formData.forEach((value, key) => {
                jsonData[key] = value;
            });
    
            // Emit a socket event with the form data
            socket.emit("admin-updated-value", jsonData);
            return true;
        }
    
        // Add event listener to the form for form submission
        document.getElementById("updateForm").addEventListener("submit", handleSubmit);
    </script>
</body>

</html>