<%- include("partials/header"); -%>

                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">
                    <div class="col-xl-12 col-lg-12">
                        <div class="card shadow mb-4">
                            <!-- Card Header - Dropdown -->
                            <div
                                class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                <h6 class="m-0" style="color: #501bd7eb; font-weight: 700;">Add Game</h6>
                            </div>
                            <!-- Card Body -->
                            <% if(game == 1){ %>

                            <div class="card-body">
                                <form action="/add" method="post">
                                    <div class="mb-3">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                        <label for="validationCustomUsername" class="form-label">Game Name<sup>*</sup></label>
                                        <input type="text" class="form-control input is-invalid" name="name" id="validationCustomUsername" aria-describedby="validationServer03Feedback" required>
                                        <div id="validationServer03Feedback" class="invalid-feedback">
                                          Game name already exists.
                                        </div>
                                      </div>
                                    <div class="form-group">
                                        <!-- <label for="exampleInputEmail1">Upload excel<sup>*</sup></label> -->
                                        <input type="file" hidden class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="" name="excel">
                                    </div>
                                    <!--Image upload-->
                                    <button type="submit" class="btn btn-primary" style="background:#bcaced; color: #501bd7eb; font-weight: 700;">Submit</button>
                                </form>
                            </div>
                            <% } %> 

                            <% if(game == 0){ %>

                            <div class="card-body">
                                <form action="/add" method="post">
                                    <div class="form-group">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                      <label for="exampleInputEmail1">Game Name<sup>*</sup></label>
                                      <input type="text" required class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder=""  name="name">
                                      <label for="gameStartTime">Game Start Time<sup>*</sup></label>
                                      <input type="time" required class="form-control" id="gameStartTime" placeholder=""  name="gameStartTime">
                                      <label for="gameTime">Game Result Time<sup>*</sup></label>
                                      <input type="time" required class="form-control" id="gameTime" placeholder=""  name="gameEndTime">
                                     
                                      <label for="spinNumber">Spin Number<sup>*</sup></label>
                                      <input type="text" required class="form-control" id="spinNumber" placeholder=""  name="spinNumber" pattern="([1-9]|[1-9][0-9]|100)" title="enter valid numbers in 1-100">
                                   
                                    </div>
                                    <div class="form-group">
                                        <!-- <label for="exampleInputEmail1">Upload excel<sup>*</sup></label> -->
                                        <input type="file" hidden class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="" name="excel">
                                    </div>
                                    <!--Image upload-->
                                    <button type="submit" class="btn btn-primary" style="background:#bcaced; color: #501bd7eb; font-weight: 700;">Submit</button>
                                </form>
                            </div>

                            <% } %> 

                        </div>
                    </div>
                    
                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
         
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="/logout">Logout</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="vendor/jquery/jquery.min.js"></script>
    <script src="vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="vendor/chart.js/Chart.min.js"></script>

    <!-- Page level custom scripts -->
    <script src="js/demo/chart-area-demo.js"></script>
    <script src="js/demo/chart-pie-demo.js"></script>

</body>

</html>